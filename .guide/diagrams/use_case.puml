@startuml
left to right direction
actor "User" as user
actor "Camera" as cam
actor "Ultrasonic Sensor" as sensor

rectangle "Smart Bin System" {
    usecase "Dispose Waste" as UC1
    usecase "Identify Waste Type" as UC2
    usecase "Open Correct Lid" as UC3
    usecase "Monitor Bin Capacity" as UC4
    usecase "Alert if Full" as UC5
    usecase "View Status Preview" as UC6
}

user -- UC1
user -- UC6

cam -- UC2
UC2 ..> UC3 : <<include>>

sensor -- UC4
UC4 ..> UC5 : <<include>>

UC1 -- UC3
@enduml
